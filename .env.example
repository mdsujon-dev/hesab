# MongoDB connection string (local or Atlas)
MONGODB_URI="mongodb://127.0.0.1:27017/income-expense"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Password-reset email (Gmail SMTP: use an App Password, not the account password)
EMAIL_USER="you@gmail.com"
EMAIL_PASS="your-16-character-app-password"

# Public origin used to build reset links in emails
APP_URL="http://localhost:3000"
